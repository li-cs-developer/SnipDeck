# Normalize line endings
* text=auto eol=lf

# Windows-specific files
*.sln text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.manifest text eol=crlf
*.resx text eol=crlf
*.iss text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.dll binary
*.exe binary
*.pdb binary

# Linguist overrides (so GitHub doesn't miscount)
*.resx linguist-language=XML
*.fr-CA.resx linguist-language=XML