<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush"  Color="#141A22"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#1C242E"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"     Color="#242E3A"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="#2E3A46"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#8B9AA7"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="#4CC6FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"    Color="#6FD2FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush"  Color="#3CAFF2"/>
    <SolidColorBrush x:Key="SelectionBrush"      Color="#4CC6FF" Opacity="0.30"/>
    <SolidColorBrush x:Key="DangerBrush"         Color="#F26B70"/>

</ResourceDictionary>