<Window x:Class="SnipDeck.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnipDeck.App.Controls"
        xmlns:loc="clr-namespace:SnipDeck.Localization;assembly=SnipDeck.Localization"
        Icon="/Resources/app.ico"
        Title="{loc:Loc AppTitle}" Height="560" Width="780"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate x:Key="TextTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayText}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           MaxHeight="42"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding TimestampText}"
                               Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="{Binding TagsText}"
                               Margin="8,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ImageTemplate">
            <StackPanel>
                <Border CornerRadius="4" ClipToBounds="True"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Image Source="{Binding Thumbnail}" MaxHeight="90" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding TimestampText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding DisplayText}"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding TimestampText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <controls:ClipboardItemTemplateSelector x:Key="ItemTemplateSelector"
            TextTemplate="{StaticResource TextTemplate}"
            ImageTemplate="{StaticResource ImageTemplate}"
            FileTemplate="{StaticResource FileTemplate}"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{loc:Loc ClipboardHistoryHeading}"
                       Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="{loc:Loc SettingsButton}"
                    Style="{StaticResource FlatButtonStyle}"
                    ToolTip="{loc:Loc SettingsButton}"
                    AutomationProperties.Name="{loc:Loc SettingsButton}"
                    Click="OpenSettings_Click"/>
        </Grid>

        <!-- Filter bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinHeight="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Padding="10,0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{loc:Loc AccessibilitySearchBox}"
                                 Text="{Binding Filter.Query,
                                                UpdateSourceTrigger=PropertyChanged,
                                                Delay=200}"/>

                        <TextBlock Text="{loc:Loc SearchPlaceholder}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Padding="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="1"
                            x:Name="ClearSearchButton"
                            Content="✕"
                            Width="20" Height="20"
                            Margin="0,0,8,0"
                            FontSize="11"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            ToolTip="{loc:Loc ClearSearchTooltip}"
                            AutomationProperties.Name="{loc:Loc ClearSearchTooltip}"
                            Click="ClearSearch_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SurfaceAltBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <ComboBox Grid.Column="1"
                      Width="140"
                      Margin="8,0,0,0"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      AutomationProperties.Name="{loc:Loc AccessibilitySortCombo}"
                      SelectedValue="{Binding Filter.Sort}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="{loc:Loc SortNewestFirst}" Tag="Newest first"/>
                <ComboBoxItem Content="{loc:Loc SortOldestFirst}" Tag="Oldest first"/>
                <ComboBoxItem Content="{loc:Loc SortMostUsed}"    Tag="Most used"/>
            </ComboBox>
        </Grid>

        <!-- List + Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ListBox x:Name="HistoryList"
                         ItemsSource="{Binding Items}"
                         SelectionMode="Extended"
                         SelectionChanged="HistoryList_SelectionChanged"
                         ItemTemplateSelector="{StaticResource ItemTemplateSelector}"
                         ItemContainerStyle="{StaticResource HistoryListBoxItemStyle}"
                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="HistoryList_PreviewMouseLeftButtonDown"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="{loc:Loc AccessibilityHistoryList}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{x:Static ApplicationCommands.Delete}"/>
                        <KeyBinding Key="A" Modifiers="Control" Command="{x:Static ApplicationCommands.SelectAll}"/>
                    </ListBox.InputBindings>
                    <ListBox.CommandBindings>
                        <CommandBinding Command="{x:Static ApplicationCommands.Delete}"
                                        Executed="Delete_Executed"
                                        CanExecute="Delete_CanExecute"/>
                        <CommandBinding Command="{x:Static ApplicationCommands.SelectAll}"
                                        Executed="SelectAll_Executed"/>
                    </ListBox.CommandBindings>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc ContextMenuDelete}" Click="DeleteItem_Click"/>
                            <MenuItem Header="{loc:Loc ContextMenuDeleteSelected}" Click="DeleteSelected_Click"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc ContextMenuCopy}" Click="CopySelected_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    AutomationProperties.Name="{loc:Loc AccessibilityPreviewPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Preview.Header}"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Text="{Binding Preview.TagLine}"
                               Margin="0,4,0,8"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBox Text="{Binding Preview.FullText, Mode=OneWay}"
                                     Visibility="{Binding Preview.IsText, Converter={StaticResource BoolToVis}}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>

                            <Image Source="{Binding Preview.FullImage}"
                                   Visibility="{Binding Preview.IsImage, Converter={StaticResource BoolToVis}}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>

                            <TextBlock Text="{Binding Preview.FullPath}"
                                       Visibility="{Binding Preview.IsFile, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="TagInput"
                                 Width="110"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="6,3"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{loc:Loc TagInputTooltip}"
                                 AutomationProperties.Name="{loc:Loc AccessibilityTagInput}"/>
                        <Button Content="{loc:Loc AddTagButton}"
                                Margin="4,0,0,0"
                                Padding="8,3"
                                FontSize="12"
                                Style="{StaticResource FlatButtonStyle}"
                                AutomationProperties.Name="{loc:Loc AddTagButton}"
                                Click="AddTag_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="3"
                Content="{loc:Loc ClearAllButton}"
                Style="{StaticResource DangerButtonStyle}"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"
                AutomationProperties.Name="{loc:Loc ClearAllButton}"
                Click="ClearAll_Click"/>
    </Grid>
</Window>